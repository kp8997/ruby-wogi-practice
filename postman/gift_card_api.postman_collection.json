    {
      "name": "05. Client - Catalog Browsing & Card Lifecycle",
      "description": "Client workflow: Search assigned catalog, issue card with idempotency, check idempotency retry, view cards, and cancel card.",
      "item": [
        {
          "name": "1. Client Browse Catalog (CLI-2)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/catalog?query=Acme",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "catalog"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "Acme"
                }
              ]
            },
            "description": "Searches and filters active products assigned to the authenticated client."
          },
          "response": []
        },
        {
          "name": "2. Issue Gift Card (CLI-3, CLI-4)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (pm.response.code === 201 && jsonData.card && jsonData.card.id) {",
                  "    pm.collectionVariables.set('card_id', jsonData.card.id);",
                  "    console.log('card_id set to ' + jsonData.card.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": {{product_id}},\n  \"idempotency_key\": \"order-trans-{{$timestamp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cards",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cards"
              ]
            },
            "description": "Issues a gift card. Snapshots client's current payout_rate onto card, generates a 16-digit activation number, and saves card_id."
          },
          "response": []
        },
        {
          "name": "3. Retry Card Issuance (Safe Idempotency Check CLI-4)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": {{product_id}},\n  \"idempotency_key\": \"idempotent-test-key-001\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cards",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cards"
              ]
            },
            "description": "Calling this repeatedly with the same idempotency_key safely returns the existing card record without creating duplicates."
          },
          "response": []
        },
        {
          "name": "4. List Issued Cards (CLI-1)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
