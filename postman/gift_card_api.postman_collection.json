{
  "info": {
    "_postman_id": "7f89d3a1-2d34-4b52-9c12-8e34589d1234",
    "name": "Gift Card API",
    "description": "Comprehensive Postman collection for the Gift Card API platform (Ruby 3.4.x, Rails 8.1.x, Grape, PostgreSQL). Includes sequential flows for Admin management (Users, Clients, Brands, Products, Permissions, Audit Logs, Reports) and Client operations (Catalog search, Card issuance with idempotency, Card cancellation, and Spending reports).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "admin_email",
      "value": "admin@example.com",
      "type": "string"
    },
    {
      "key": "admin_password",
      "value": "Admin@12345",
      "type": "string"
    },
    {
      "key": "client_email",
      "value": "client1@example.com",
      "type": "string"
    },
    {
      "key": "client_password",
      "value": "Client@12345",
      "type": "string"
    },
    {
      "key": "client_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "brand_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "product_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "card_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Authentication Flow",
      "description": "Authentication endpoints: Login as Admin, Login as Client, and Logout (JWT token revocation).",
      "item": [
        {
          "name": "1. Admin Login (AUTH-1, ADM-1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (pm.response.code === 200 && jsonData.token) {",
                  "    pm.collectionVariables.set('authToken', jsonData.token);",
                  "    console.log('authToken captured successfully');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Logs in with the seed admin account and saves the resulting JWT token in collection variable `authToken`."
          },
          "response": []
        },
        {
          "name": "2. Client Login (AUTH-1, CLI-1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (pm.response.code === 200 && jsonData.token) {",
                  "    pm.collectionVariables.set('authToken', jsonData.token);",
                  "    console.log('authToken captured successfully');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{client_email}}\",\n  \"password\": \"{{client_password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Logs in with client credentials and saves JWT token in collection variable `authToken`."
          },
          "response": []
        },
        {
          "name": "3. Logout (AUTH-9)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Revokes the active JWT token by recording its JTI in RevokedToken. Further calls with this token will return 401."
          },
          "response": []
        }
      ]
    },
    {
