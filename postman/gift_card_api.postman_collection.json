            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme Global Partners\",\n  \"email\": \"acme_global@example.com\",\n  \"password\": \"Client@12345\",\n  \"payout_rate\": 6.25\n}"
