              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "20"
                }
              ]
            },
            "description": "Paginated list of clients with user details, payout_rate, and state."
          },
          "response": []
        },
        {
          "name": "4. Get Client by ID (ADM-5)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/clients/{{client_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "clients",
                "{{client_id}}"
              ]
            },
            "description": "Fetches a single client by ID."
          },
          "response": []
        },
        {
          "name": "5. Update Client (ADM-5, LOG-2)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme Global Superstore\",\n  \"payout_rate\": 7.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/clients/{{client_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "clients",
                "{{client_id}}"
              ]
            },
            "description": "Updates client name and/or payout_rate. Audits before and after values (client.update)."
          },
          "response": []
        },
        {
          "name": "6. Toggle Client State (ADM-9, AUTH-8)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"state\": \"active\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/clients/{{client_id}}/state",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "clients",
                "{{client_id}}",
                "state"
              ]
            },
            "description": "Sets client user state to active or inactive. When inactive, the client cannot log in or call APIs."
          },
          "response": []
        }
      ]
    },
