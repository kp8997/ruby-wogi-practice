# Application Port on Host (defaults to 3000)
APP_PORT=3000

# PostgreSQL Port on Host (defaults to 5432)
DB_PORT=5432

# Database Credentials
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=gift_card_development
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# JWT Authentication
JWT_SECRET_KEY=replace_with_secure_random_key_in_production

# Active Record encryption secret key
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=value

# Rails Secret Key Base (cryptographic key used by Rails)
SECRET_KEY_BASE=replace_with_secure_random_key_in_production
